{
  "openapi": "3.0.0",
  "info": {
    "title": "Urja Meter Ops API Wrapper",
    "version": "1.0.0",
    "description": "Clean API wrapper around the legacy Urja Meter Ops portal."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/api/meters/{id}/energy": {
      "get": {
        "summary": "Get energy consumption for a specific meter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter ID (e.g., J100000)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  }
}